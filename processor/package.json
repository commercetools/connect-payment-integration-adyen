{
  "name": "payment-integration-adyen",
  "version": "5.31.0",
  "description": "Payment integration with Adyen",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "node_modules/.bin/nodemon -q dist/main.js",
    "lint": "prettier --check \"**/**/*.{ts,js,json}\" && eslint src",
    "lint:fix": "prettier --write \"**/**/*.{ts,js,json}\" && eslint --fix src",
    "build": "rm -rf /dist && tsc",
    "dev": "ts-node src/main.ts",
    "watch": "nodemon --watch \"src/**\" --ext \"ts,json\" --ignore \"src/**/*.spec.ts\" --exec \"ts-node src/main.ts\" --legacy-watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "connector:post-deploy": "node dist/connectors/post-deploy.js",
    "connector:pre-undeploy": "node dist/connectors/pre-undeploy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@adyen/api-library": "32.2.0",
    "@commercetools-backend/loggers": "27.12.0",
    "@commercetools/connect-payments-sdk": "1.6.0",
    "@fastify/autoload": "6.5.0",
    "@fastify/cors": "11.3.0",
    "@fastify/formbody": "9.0.0",
    "@fastify/http-proxy": "11.6.4",
    "@fastify/request-context": "7.0.0",
    "@fastify/static": "10.1.5",
    "@fastify/type-provider-typebox": "6.1.0",
    "@sinclair/typebox": "0.34.52",
    "dotenv": "18.0.5",
    "fastify": "5.12.5",
    "fastify-plugin": "6.0.0"
  },
  "devDependencies": {
    "@commercetools/composable-commerce-test-data": "13.13.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "msw": "3.0.2",
    "node-fetch": "3.3.2",
    "nodemon": "3.1.14",
    "prettier": "3.9.9",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "lodash": "4.18.1",
    "brace-expansion": "5.0.12",
    "js-yaml": "4.3.2",
    "@commercetools/composable-commerce-test-data": {
      "@commercetools-frontend/application-config": {
        "ajv": "8.20.0",
        "dompurify": "3.4.16"
      }
    },
    "chokidar": "4.0.3"
  }
}
